@page "/register"
@layout LoginLayout
@using System.ComponentModel.DataAnnotations
@inject NavigationManager Nav
@inject HttpClient Http
@using MyBlazorApp.Services
@inject AuthService Auth


<h1>Register</h1>

<EditForm Model="model" OnValidSubmit="DoRegister" FormName="register">
    <DataAnnotationsValidator />

    <div class="mb-3">
        <label class="form-label">Email</label>
        <InputText type="email" class="form-control" @bind-Value="model.Email" />
        <ValidationMessage For="() => model.Email" />
    </div>

    <div class="mb-3">
        <label class="form-label">Password</label>
        <InputText type="password" class="form-control" @bind-Value="model.Password" />
        <ValidationMessage For="() => model.Password" />
    </div>

    <div class="mb-3">
        <label class="form-label">Confirm password</label>
        <InputText type="password" class="form-control" @bind-Value="model.ConfirmPassword" />
        <ValidationMessage For="() => model.ConfirmPassword" />
    </div>

    <button class="btn btn-primary" type="submit" disabled="@loading">Register</button>
</EditForm>

@if (error is not null)
{
    <p class="text-danger mt-3">@error</p>
}


<p class="mt-3">Already have an account? <a href="/">Log in</a></p>

@code {
    private RegisterModel model = new();

    private string? error;
    private bool loading;

    private record RegisterResponse(string? Message, string? Token);

    private async Task DoRegister()
    {
        error = null;
        loading = true;
        try
        {
            var res = await Http.PostAsJsonAsync("/register", new { email = model.Email, password = model.Password });
            var body = await res.Content.ReadFromJsonAsync<RegisterResponse>();

            if (res.IsSuccessStatusCode)
            {
                await Auth.SaveTokenAsync(body!.Token!);
                Nav.NavigateTo("/home");
            }
            else
            {
                error = body?.Message ?? "Registration failed";
            }
        }
        catch (HttpRequestException)
        {
            error = "Could not reach the server";
        }
        catch (Exception)
        {
            error = "Registration failed";
        }
        finally
        {
            loading = false;
        }
    }


    public class RegisterModel
    {
        [Required(ErrorMessage = "Insert email")]
        [EmailAddress(ErrorMessage = "Invalid email")]
        public string Email { get; set; } = "";

        [Required(ErrorMessage = "Insert password")]
        [MinLength(8, ErrorMessage = "At least 8 characters")]
        public string Password { get; set; } = "";

        [Required(ErrorMessage = "Confirm the password")]
        [Compare(nameof(Password), ErrorMessage = "Passwords do not match")]
        public string ConfirmPassword { get; set; } = "";
    }
}
