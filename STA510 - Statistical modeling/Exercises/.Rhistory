x_a <- 1:4
c_a <- sum(x_a)
f_a <- x_a / c_a
c_a
data.frame(x = x_a, f_x = f_a)
sum(f_a)
x_b <- 0:3
c_b <- 1 / sum((x_b + 1)^2)
f_b <- c_b * (x_b + 1)^2
c_b
data.frame(x = x_b, f_x = f_b)
sum(f_b)
barplot(
height = f_a,
names.arg = x_a,
xlab = "x",
ylab = "f(x)",
main = "PMF a",
col = "skyblue",
ylim = c(0, 0.6)
)
barplot(
height = f_b,
names.arg = x_b,
xlab = "x",
ylab = "f(x)",
main = "PMF b",
col = "lightgreen",
ylim = c(0, 0.6)
)
x_a <- 1:4
c_a <- sum(x_a)
f_a <- x_a / c_a
E_X_a <- sum(x_a * f_a)
E_gX_a <- sum(x_a^3 * f_a)
E_X_a
E_gX_a
