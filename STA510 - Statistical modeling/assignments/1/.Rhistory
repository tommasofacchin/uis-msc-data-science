### iii)
# STA510 - Mandatory Assignment 1
# Author: Tommaso Facchin
rm(list = ls())
# Problem 1 -------------------------------------------------------------------
# d) Inverse-transform sampling
a <- 5
n <- 5000
F <- function(x, a) {
(3 / 4000) * (10 * (x - a)^2 - (x - a)^3 / 3)
}
F_inv <- function(p, a) {
uniroot(
function(x) F(x, a) - p,
lower = a,
upper = a + 20
)$root
}
set.seed(42)
u <- runif(n)
wind_speed <- sapply(u, F_inv, a = a)
hist(
wind_speed,
breaks = "Scott",
probability = TRUE,
col = "lightblue",
main = "Histogram of simulated wind speeds",
xlab = "Wind speed (m/s)"
)
curve(
(3 / 4000) * (x - 5) * (25 - x),
from = 5,
to = 25,
add = TRUE,
col = "red",
lwd = 2
)
# The simulated values follow the expected parabolic shape. The density is
# close to zero near 5 m/s and 25 m/s and reaches its maximum around 15 m/s.
plot(
ecdf(wind_speed),
main = "Empirical and true CDF",
xlab = "Wind speed (m/s)",
ylab = "Cumulative probability",
col = "lightblue",
lwd = 2
)
curve(
(3 / 4000) * (10 * (x - 5)^2 - (x - 5)^3 / 3),
from = 5,
to = 25,
add = TRUE,
col = "red",
lwd = 2
)
# The empirical CDF is a step function based on the simulated sample, whereas
# the true CDF is smooth. The two curves are almost overlapping.
# e) iii) Theoretical acceptance rate and expected proposals
M <- 3 / 2
theoretical_rate <- 1 / M
expected_proposals <- n / theoretical_rate
cat("Problem 1(e)(iii): theoretical acceptance rate =",
theoretical_rate, "\n")
cat("Problem 1(e)(iii): expected proposals for", n,
"accepted samples =", expected_proposals, "\n")
# The theoretical acceptance rate is 1/M = 2/3, or approximately 66.67%.
# To generate 5000 accepted samples, we expect 5000/(2/3) = 7500 proposals.
# f) Acceptance-rejection sampling
a <- 5
n <- 5000
M <- 3 / 2
wind_ar <- numeric(n)
proposed <- 0
i <- 1
while (i <= n) {
x <- runif(1, min = a, max = a + 20)
u <- runif(1)
acceptance_probability <- (
(3 / 4000) * (x - a) * (a + 20 - x)
) / (M * (1 / 20))
proposed <- proposed + 1
if (u <= acceptance_probability) {
wind_ar[i] <- x
i <- i + 1
}
}
empirical_rate <- n / proposed
cat("Problem 1(f): empirical acceptance rate =", empirical_rate, "\n")
# f) i) Compare the acceptance-rejection sample with the true density.
hist(
wind_ar,
breaks = "Scott",
probability = TRUE,
col = "lightblue",
main = "AR simulated wind speeds",
xlab = "Wind speed (m/s)",
ylab = "Density"
)
curve(
(3 / 4000) * (x - 5) * (25 - x),
from = 5,
to = 25,
add = TRUE,
col = "red",
lwd = 2
)
# The histogram follows the true density well. Small differences are due to
# random sampling variation.
# f) ii) Compare the empirical and theoretical acceptance rates.
cat("Problem 1(f)(ii): empirical rate =", round(empirical_rate, 4),
"; theoretical rate =", round(theoretical_rate, 4), "\n")
# The empirical rate is close to 1/M = 2/3. The small difference is due to
# random variation in the simulation.
# f) iii) Method comparison
# Inverse-transform sampling is preferable when the inverse CDF is available
# or can be computed efficiently: each uniform draw produces one sample.
# Acceptance-rejection is preferable when the inverse CDF is difficult to
# obtain but a good proposal distribution is available. Here its theoretical
# acceptance rate is 2/3.
# Problem 2 -------------------------------------------------------------------
rain <- c(
3.1, 7.2, 5.4, 12.0, 8.8, 4.3, 9.6, 6.1, 11.2, 2.9,
7.5, 14.1, 5.0, 9.3, 6.8, 10.4, 3.7, 8.1, 13.5, 4.6,
6.3, 11.8, 7.9, 5.5, 9.0, 12.7, 4.1, 8.4, 6.6, 10.1,
3.4, 7.0, 5.8, 13.2, 9.7, 6.2, 11.5, 4.8, 8.9, 7.3
)
cat("Problem 2: sum of rainfall measurements =", sum(rain), "mm\n")
cat("Problem 2: sample mean =", mean(rain), "mm\n")
# c) CLT-based sample size
# By the CLT, for sufficiently large n, the sample mean is approximately
# normal with mean beta and standard deviation beta/sqrt(n). For a 95% margin
# of error of at most 1 mm, require z_0.975 * beta/sqrt(n) <= 1.
# Since beta is unknown, use mean(rain) as a pilot estimate.
z <- qnorm(0.975)
n_required <- ceiling((z * mean(rain) / 1)^2)
cat("Problem 2(c): z_0.975 =", z, "\n")
cat("Problem 2(c): required total measurements =", n_required, "\n")
cat("Problem 2(c): additional measurements =",
n_required - length(rain), "\n")
# d) i) MLE of beta
# For the exponential distribution with scale beta, the MLE is the sample mean.
beta_hat <- mean(rain)
cat("Problem 2(d)(i): beta_hat =", beta_hat, "mm\n")
# d) ii) Approximate 95% confidence interval using the CLT
# Use the observed sample size (40), not the planned sample size from part c.
n_observed <- length(rain)
se_hat <- beta_hat / sqrt(n_observed)
ci <- beta_hat + c(-1, 1) * z * se_hat
cat("Problem 2(d)(ii): approximate 95% CI for beta = (",
round(ci[1], 2), ", ", round(ci[2], 2), ") mm\n", sep = "")
# Interpretation: We are approximately 95% confident that the true mean
# rainfall on a wet day lies between 5.41 mm and 10.28 mm.
