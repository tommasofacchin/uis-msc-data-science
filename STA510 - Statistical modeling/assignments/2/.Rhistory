m <- 5000
U <- runif(m, min = 0, max = 2)
U_AT <- 2 - U
m <- 5000
U <- runif(m, min = 0, max = 2)
U_AT <- 2 - U
I_AT
m <- 5000
U <- runif(m, min = 0, max = 2)
U_AT <- 2 - U
m <- 5000
U <- runif(m, min = 0, max = 2)
U_AT <- 2 - U
I_AT <- 2 * mean((f(U) + f(U_AT)) / 2)
I_AT
source("C:/Tommaso/uis-msc-data-science/STA510 - Statistical modeling/assignments/2/mandatory2.R")
g <- function(t) {
exp(-t / 2) / (2 * (1 - exp(-1)))
}
t <- seq(0, 2, length.out = 500)
plot(
t, f(t),
type = "l",
col = "blue",
lwd = 2,
ylim = range(f(t), g(t)),
xlab = "t",
ylab = "Function value",
main = "Comparison of f(t) and g(t)"
)
lines(t, g(t), col = "red", lwd = 2)
legend(
"topright",
legend = c("f(t)", "g(t)"),
col = c("blue", "red"),
lwd = 2
)
grid()
