source("C:/Tommaso/uis-msc-data-science/STA510 - Statistical modeling/assignments/2/mandatory2.R")
U_IS <- runif(n, min = 0, max = 1)
T_IS <- -2 * log(1 - U_IS * (1 - exp(-1)))
I_IS <- mean(f(T_IS) / g(T_IS))
I_IS
